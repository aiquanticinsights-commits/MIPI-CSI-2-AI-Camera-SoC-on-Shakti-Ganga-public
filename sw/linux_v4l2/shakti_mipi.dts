// shakti_mipi.dts – Device tree overlay for Ganga (RV64) + MC20901
// Include via your Shakti Ganga board system.dts (see docs/setup_guide.md)
/dts-v1/;
/ {
  model = "Shakti Ganga MIPI AI Camera";
  compatible = "shakti,ganga-mipi";
  #address-cells = <1>; #size-cells = <1>;
  cpus { #address-cells = <1>; #size-cells = <0>; cpu@0 { device_type="cpu"; compatible="shakti,c-class"; reg=<0>; }; };
  memory@80000000 { device_type="memory"; reg=<0x80000000 0x10000000>; }; // 256 MB DDR
  clk_100m: clk-100m { compatible="fixed-clock"; #clock-cells=<0>; clock-frequency=<100000000>; };

  soc {
    #address-cells = <1>; #size-cells = <1>; compatible="simple-bus"; ranges;
    // Shakti PLIC/CLINT at 0x00010000 (see shakti_baseline.md)
    // MIPI CSI-2 hard via MC20901 at 0x44A0_0000 (AXI-Lite), DMA at 0x44B0_0000
    mipi_csi2@44a00000 {
      compatible = "shakti,mipi-csi2-ganga", "xlnx,mipi-csi2-rx-subsystem-3.0";
      reg = <0x44A00000 0x10000>;
      interrupts = <0 1>; // PLIC irq_f2p[0]; interrupt-parent supplied by board DTS
      clocks = <&clk_100m>;
      port { csi2_in: endpoint { data-lanes=<1 2 3 4>; }; }; // add remote-endpoint=<&sensor_out> for your sensor
    };
    vc_merge@44a10000 { compatible="shakti,vc-merge"; reg=<0x44A10000 0x10000>; };
    isp@44a20000 { compatible="shakti,isp"; reg=<0x44A20000 0x10000>; };
    ai_preproc@44a30000 { compatible="shakti,ai-preproc"; reg=<0x44A30000 0x10000>; };
    dma@44b00000 { compatible="xlnx,axi-dma"; reg=<0x44B00000 0x10000>; };
    i2c@44c00000 { compatible="shakti,i2c"; reg=<0x44C00000 0x10000>; #address-cells=<1>; #size-cells=<0>;
      sensor: imx219@10 { compatible="sony,imx219"; reg=<0x10>; };
    };
    gpio@44d00000 { compatible="shakti,gpio"; reg=<0x44D00000 0x10000>; gpio-line-names="cam_rst","cam_pwdn"; };
  };
};

